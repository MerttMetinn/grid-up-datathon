# Ham datathon verisi — büyük (~130 MB), ayrı dağıtılır (bkz. README > Kurulum)
# data/raw/*.csv -> tutarlılık için geri eklendi

# Türetilen parquet cache — data.py ilk çalıştırmada yeniden üretir
data/processed/*.parquet

# Materialize edilen dataset paketi — büyük, scripts/18 ile yeniden üretilir
data/dataset/*.parquet

# NOT: data/processed/test_history_profile.csv KASITLI tutulur —
# recon-3 üretir, validation.py ona bağımlıdır, küçüktür.

# Geçici / editör
scratchpad/
.DS_Store
*.swp

# Notebook yeniden uretim ciktisi (dogrulama kosusu)
repro_out/
smoke_out/

# ---------------------------------------------------------------------------
# Submission CSV'leri — her biri ~28 MB. Notebook DETERMINISTIK oldugu icin
# (iki bagimsiz kosu bit duzeyinde ayni, bkz. docs/VERI_KAYNAKLARI.md) bunlar
# yeniden uretilebilir; git'te tutmaya gerek yok.
#
# Istisna: final olarak secilen iki dosya depoda kalir.
submissions/*.csv
!submissions/sub_sp17.csv
!submissions/sub_sp30.csv

# NOT: bu kuraldan ONCE commit'lenmis ~32 submission dosyasi hala IZLENIYOR.
